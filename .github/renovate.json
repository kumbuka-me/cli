{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["/^(?:github\\.com\\/)?kumbuka-me\\//"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["prettier", "golangci/golangci-lint"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
